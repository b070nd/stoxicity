# Copy to .env.local and fill in. .env.local is git-ignored; this file is not.
# Keep this file free of real values.

STOXICITY_CONTACT=
STOXICITY_GMAIL_CLIENT_ID=
STOXICITY_GMAIL_CLIENT_SECRET=
STOXICITY_MAIL_FROM=
STOXICITY_MAIL_TO=
STOXICITY_WEBHOOK_URL=
STOXICITY_LAYA_API_KEY=
STOXICITY_POLYGON_KEY=

# Where the databases and the backups live. Keep both OUTSIDE the source folder so
# git can never see them. Use absolute paths: ~ and $HOME are not expanded.
# Without these, data goes to data/ and backups/ beside .env (git-ignored, but inside the repo).
# STOXICITY_DATA_DIR=/Users/you/.stoxicity/data
# STOXICITY_BACKUP_DIR=/Users/you/.stoxicity/backups
