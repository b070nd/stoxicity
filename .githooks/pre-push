#!/bin/sh
# Blocks a push that would publish real data, credentials or build output.
# git passes: <local ref> <local sha> <remote ref> <remote sha> on stdin.
guard="$(git rev-parse --show-toplevel)/.githooks/guard-no-data.sh"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue      # deleting a branch publishes nothing
  # every commit that is not already on some remote
  "$guard" range "$local_sha" --not --remotes || status=1
done
[ "$status" -eq 0 ] || echo "push refused by .githooks/pre-push" >&2
exit $status
