# build output and runtime state
/bin/
/dist/
/data/
/backups/
/app/data/

# other tenants stay local; only the default tenant and the *.example watches are tracked
/app/config/tenants/*
!/app/config/tenants/default/

# credentials: .env is tracked and holds settings only; anything local is ignored
.env.local
.env.*.local
/.claude/settings.local.json

# stray binaries from "go build" run inside app/
/app/stoxicity
/app/stoxicity-tui
/app/src/cmd/stoxicity/stoxicity
/app/src/cmd/stoxicity-tui/stoxicity-tui

# private maintenance summary (local only)
/MAINTENANCE.md

# real data must never be committed or pushed (see .githooks/guard-no-data.sh)
# the program's own folders
/research/
/exports/
/reports/
/private/
/local/
# databases and copies of them, wherever they are
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# statements, prices, bars, marks, rates and exports you write or download
*.csv
*.tsv
*.xlsx
*.xls
# your policy, fee schedule and broker files kept next to the code
/policy*.yaml
/policy*.yml
/policy*.json
/fees*.json
/broker*.json
# stray copies of the built binary
/app/src/stoxicity
