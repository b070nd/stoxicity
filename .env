# stoxicity settings. Safe to commit: NO secrets in this file.
# Credentials, tokens and your own email address go in .env.local.
#
# Load order, later wins: config.yaml < .env < .env.local < the real environment.
# See docs/configuration.md.

# Which tenant to open when -tenant is not given.
STOXICITY_TENANT=default

# Which day an article belongs to (timeline, daily digest, digest times).
# Europe/Berlin is CET (UTC+1) in winter and CEST (UTC+2) in summer.
STOXICITY_TIMEZONE=Europe/Berlin

STOXICITY_DATA_DIR=./data
STOXICITY_LOG_LEVEL=info

# Email channel: the SMTP server. The account and password are in .env.local.
STOXICITY_SMTP_HOST=smtp.gmail.com
STOXICITY_SMTP_PORT=587

# File channel: alerts and digests written as Markdown files, one per
# notification, into this folder (created if missing). A relative path starts at
# the folder of this file. Used by watches that list `file` as a channel.
# STOXICITY_FILE_DIR=./data/outbox

# Feed channel: an Atom file a feed reader can subscribe to. All three are
# needed together. The URL is where you serve the file from (see
# STOXICITY_PUBLIC_URL below). Used by watches that list `feed` as a channel.
# STOXICITY_FEED_PATH=./data/feed.atom
# STOXICITY_FEED_TITLE=stoxicity
# STOXICITY_FEED_URL=https://example.com/feed.atom

# laya-serve sidecar (off by default, see config.yaml). The key is in .env.local.
STOXICITY_LAYA_URL=http://127.0.0.1:8000

# Public address of this installation, used for links in the feed and email
# channels. Leave unset until you own the domain.
# STOXICITY_PUBLIC_URL=https://stoxi.city
